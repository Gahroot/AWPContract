generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALESMAN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  COMPLETED
}

enum CommissionType {
  SALES_REP
  SETTER
  SETTER_MANAGER
  TERRITORY_OWNER
  VP
  NSM
}

// ─── Auth.js Models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SALESMAN)
  market        String    @default("SLC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Management flags
  isSetterManager  Boolean  @default(false)
  isTerritoryOwner Boolean  @default(false)
  isVP             Boolean  @default(false)
  isNSM            Boolean  @default(false)
  territory        String?

  accounts          Account[]
  sessions          Session[]
  contracts         Contract[]
  salesRepContracts Contract[] @relation("SalesRepContracts")
  setterContracts   Contract[] @relation("SetterContracts")
  commissionRecords CommissionRecord[]
  invitesSent       Invite[]  @relation("InvitedByUser")
  inviteAccepted    Invite[]  @relation("AcceptedInvite")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Contract Models ──────────────────────────────────────────

model Contract {
  id               String         @id @default(cuid())
  contractNumber   String         @unique @default(cuid())
  status           ContractStatus @default(DRAFT)
  accessToken      String         @unique @default(cuid(2))

  // Customer Info
  customerName     String?
  customerPhone    String?
  customerPhoneAlt String?
  customerEmail    String?
  jobAddress       String?
  billingAddress   String?
  customerCity     String?
  customerZip      String?

  // Job Details
  salesman    String?
  measuredBy   String?
  leadTest    String?
  yearBuilt   String?
  houseType   String?

  // Pricing
  total            Float          @default(0)
  discount         Float          @default(0)
  contractTotal    Float          @default(0)
  downPayment      Float          @default(0)
  balanceDue       Float          @default(0)
  financeBalance   Float          @default(0)
  wfebAccount      String?

  // Marketing
  planNumber       String?
  authNumber       String?
  marketingSource  Json?

  // Payment
  paymentMethod    String?

  // New fields for HubSpot sync
  customerState          String?
  preferredCommunication String?
  downPaymentMethod      String?
  financingOption        String?
  financingLoanId        String?
  financingPlan          String?
  windowsBeingRemoved    String?
  paymentNotes             String?
  contractNotes            String?
  customerNotes            String?
  brickApplicationQty      Int      @default(0)
  stuccoApplicationQty     Int      @default(0)
  sidingApplicationQty     Int      @default(0)
  foundationApplicationQty Int      @default(0)
  woodApplicationQty       Int      @default(0)

  // Notes
  measurementNotes String?

  // Signatures
  contractorSignature     String?  @db.Text
  contractorSignatureDate DateTime?
  customerSignature       String?  @db.Text
  customerSignatureDate   DateTime?
  authorizedSignature     String?  @db.Text
  authorizedSignatureDate DateTime?
  customerAcceptedTerms   Boolean  @default(false)

  // HubSpot
  hubspotContactId String?
  hubspotDealId    String?

  // HubSpot Sync Tracking
  hubspotSyncStatus  String?
  hubspotLastSynced  DateTime?
  hubspotSyncError   String? @db.Text

  // PDF
  pdfUrl           String?

  // Relations
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  salesRepId   String?
  salesRep     User?         @relation("SalesRepContracts", fields: [salesRepId], references: [id])
  setterId     String?
  setter       User?         @relation("SetterContracts", fields: [setterId], references: [id])
  lineItems         LineItem[]
  addendums         Addendum[]
  changeOrders      ChangeOrder[]
  commissionRecords CommissionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([salesRepId])
  @@index([setterId])
  @@index([accessToken])
}

model LineItem {
  id         String @id @default(cuid())
  contractId String

  location      String?
  type          String   @default("Window")
  qty           Int      @default(1)
  width         Float    @default(0)
  height        Float    @default(0)
  color         String   @default("White")
  series        String   @default("Patriot")
  frame         String   @default("Nail Fin")
  function      String   @default("Slider")

  // Product fields
  productCode  String?
  operation    String?
  gridType     String?
  glassType    String?

  // Boolean addons
  temperedGlass  Boolean @default(false)
  obscuredGlass  Boolean @default(false)
  customShape    Boolean @default(false)
  wrap           Boolean @default(false)
  coated         Boolean @default(false)
  awpShutterRnr  Boolean @default(false)

  // Calculated price
  price     Float @default(0)
  sortOrder Int   @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Addendum {
  id         String @id @default(cuid())
  contractId String

  // Products (stored as JSON array of product objects)
  products Json?

  // Colors
  interiorColor   String?
  exteriorColor   String?
  colorDescription String?

  // Installation checklist
  installRemoveOld    Boolean @default(false)
  installHaulAway     Boolean @default(false)
  installInteriorTrim Boolean @default(false)
  installExteriorTrim Boolean @default(false)
  installCaulkSeal    Boolean @default(false)
  installScreens      Boolean @default(false)
  installHardware     Boolean @default(false)
  installWeatherstrip Boolean @default(false)
  installCleanup      Boolean @default(false)
  installOther        Boolean @default(false)
  installNotes        String?

  // Acknowledgements
  ackMeasurements    Boolean @default(false)
  ackSpecifications  Boolean @default(false)
  ackPricing         Boolean @default(false)
  ackTerms           Boolean @default(false)
  ackInitials        String?

  // Referral
  referralName  String?
  referralPhone String?

  // Notes
  notes String?

  // Signatures
  customerSignature     String?  @db.Text
  customerSignatureDate DateTime?
  contractorSignature   String?  @db.Text
  contractorSignatureDate DateTime?

  pdfUrl String?

  // HubSpot
  hubspotNoteId String?
  syncedAt      DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
}

model ChangeOrder {
  id              String @id @default(cuid())
  contractId      String
  changeOrderNumber String @unique @default(cuid())

  // Change details
  changesDescription String?
  priceChangeType    String   @default("no_change")  // no_change, increase, decrease
  priceChangeAmount  Float    @default(0)

  // Calculated
  originalPrice   Float @default(0)
  newPrice        Float @default(0)
  newBalanceDue   Float @default(0)

  // Signatures
  customerSignature     String?  @db.Text
  customerSignatureDate DateTime?
  awpSignature          String?  @db.Text
  awpSignatureDate      DateTime?

  pdfUrl String?

  // HubSpot
  hubspotNoteId String?
  syncedAt      DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@index([key])
}

// ─── Commission Models ──────────────────────────────────────

model CommissionSettings {
  id        String @id @default(cuid())

  // Sales Rep
  salesRepRate           Float @default(0.10)
  salesRepRateBelowFair  Float @default(0.05)
  salesRepFloor          Float @default(0.85)
  salesRepCeiling        Float @default(1.15)

  // Setter
  setterRate  Float @default(0.03)
  setterFloor Float @default(0.85)

  // Setter Manager
  setterManagerRate          Float @default(0.02)
  setterManagerRateBelowFair Float @default(0.01)

  // Territory Owner (tiered)
  territoryOwnerRateTier1     Float @default(0.01)
  territoryOwnerRateTier2     Float @default(0.015)
  territoryOwnerRateTier3     Float @default(0.02)
  territoryOwnerTier2Threshold Float @default(500000)
  territoryOwnerTier3Threshold Float @default(1000000)

  // VP
  vpRate          Float @default(0.01)
  vpRateBelowFair Float @default(0.005)

  // NSM
  nsmRate          Float @default(0.005)
  nsmRateBelowFair Float @default(0.0025)

  // Traditional Sales (self-gen)
  traditionalSalesRepRate          Float @default(0.12)
  traditionalSalesRepRateBelowFair Float @default(0.07)
  traditionalFloorRate             Float @default(0.85)
  traditionalPriceCeiling          Float @default(1.15)
  traditionalNsmOverrideRate          Float @default(0.005)
  traditionalNsmOverrideRateBelowFair Float @default(0.0025)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionRecord {
  id             String         @id @default(cuid())
  contractId     String
  userId         String
  commissionType CommissionType
  contractTotal  Float
  fairPrice      Float
  isBelowFair    Boolean        @default(false)
  isSelfGen      Boolean        @default(false)
  rate           Float
  amount         Float
  tierLabel      String?
  notes          String?
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([contractId])
  @@index([userId])
  @@index([commissionType])
  @@index([createdAt])
}

// ─── Invite Model ───────────────────────────────────────────

model Invite {
  id           String       @id @default(cuid())
  token        String       @unique @default(cuid(2))
  email        String
  role         Role         @default(SALESMAN)
  status       InviteStatus @default(PENDING)
  market       String       @default("SLC")
  invitedById  String
  invitedBy    User         @relation("InvitedByUser", fields: [invitedById], references: [id])
  acceptedById String?
  acceptedBy   User?        @relation("AcceptedInvite", fields: [acceptedById], references: [id])
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([token])
  @@index([email])
  @@index([status])
}
