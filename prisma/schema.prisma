generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALESMAN
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  COMPLETED
}

enum CommissionModelType {
  FLAT_PERCENT
  PER_SALESPERSON
  TIERED
}

// ─── Auth.js Models ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(SALESMAN)
  market        String    @default("SLC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  contracts         Contract[]
  commissionRate    CommissionRate?
  commissionRecords CommissionRecord[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Contract Models ──────────────────────────────────────────

model Contract {
  id               String         @id @default(cuid())
  contractNumber   String         @unique @default(cuid())
  status           ContractStatus @default(DRAFT)
  accessToken      String         @unique @default(cuid(2))

  // Customer Info
  customerName     String?
  customerPhone    String?
  customerPhoneAlt String?
  customerEmail    String?
  jobAddress       String?
  billingAddress   String?
  customerCity     String?
  customerZip      String?

  // Job Details
  salesman    String?
  measuredBy   String?
  leadTest    String?
  yearBuilt   String?
  houseType   String?

  // Pricing
  total            Float          @default(0)
  discount         Float          @default(0)
  contractTotal    Float          @default(0)
  downPayment      Float          @default(0)
  balanceDue       Float          @default(0)
  financeBalance   Float          @default(0)
  wfebAccount      String?

  // Marketing
  planNumber       String?
  authNumber       String?
  marketingSource  Json?

  // Payment
  paymentMethod    String?

  // New fields for HubSpot sync
  customerState          String?
  preferredCommunication String?
  downPaymentMethod      String?
  financingOption        String?
  financingLoanId        String?
  financingPlan          String?
  windowsBeingRemoved    String?
  paymentNotes             String?
  contractNotes            String?
  customerNotes            String?
  brickApplicationQty      Int      @default(0)
  stuccoApplicationQty     Int      @default(0)
  sidingApplicationQty     Int      @default(0)
  foundationApplicationQty Int      @default(0)
  woodApplicationQty       Int      @default(0)

  // Notes
  measurementNotes String?

  // Signatures
  contractorSignature     String?  @db.Text
  contractorSignatureDate DateTime?
  customerSignature       String?  @db.Text
  customerSignatureDate   DateTime?
  authorizedSignature     String?  @db.Text
  authorizedSignatureDate DateTime?
  customerAcceptedTerms   Boolean  @default(false)

  // HubSpot
  hubspotContactId String?
  hubspotDealId    String?

  // HubSpot Sync Tracking
  hubspotSyncStatus  String?
  hubspotLastSynced  DateTime?
  hubspotSyncError   String? @db.Text

  // PDF
  pdfUrl           String?

  // Relations
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  lineItems         LineItem[]
  addendums         Addendum[]
  changeOrders      ChangeOrder[]
  commissionRecords CommissionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([accessToken])
}

model LineItem {
  id         String @id @default(cuid())
  contractId String

  location      String?
  type          String   @default("Window")
  qty           Int      @default(1)
  width         Float    @default(0)
  height        Float    @default(0)
  color         String   @default("White")
  series        String   @default("Patriot")
  frame         String   @default("Nail Fin")
  function      String   @default("Slider")

  // Product fields
  productCode  String?
  operation    String?
  gridType     String?
  glassType    String?

  // Boolean addons
  temperedGlass  Boolean @default(false)
  obscuredGlass  Boolean @default(false)
  customShape    Boolean @default(false)
  wrap           Boolean @default(false)
  coated         Boolean @default(false)
  awpShutterRnr  Boolean @default(false)

  // Calculated price
  price     Float @default(0)
  sortOrder Int   @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Addendum {
  id         String @id @default(cuid())
  contractId String

  // Products (stored as JSON array of product objects)
  products Json?

  // Colors
  interiorColor   String?
  exteriorColor   String?
  colorDescription String?

  // Installation checklist
  installRemoveOld    Boolean @default(false)
  installHaulAway     Boolean @default(false)
  installInteriorTrim Boolean @default(false)
  installExteriorTrim Boolean @default(false)
  installCaulkSeal    Boolean @default(false)
  installScreens      Boolean @default(false)
  installHardware     Boolean @default(false)
  installWeatherstrip Boolean @default(false)
  installCleanup      Boolean @default(false)
  installOther        Boolean @default(false)
  installNotes        String?

  // Acknowledgements
  ackMeasurements    Boolean @default(false)
  ackSpecifications  Boolean @default(false)
  ackPricing         Boolean @default(false)
  ackTerms           Boolean @default(false)
  ackInitials        String?

  // Referral
  referralName  String?
  referralPhone String?

  // Notes
  notes String?

  // Signatures
  customerSignature     String?  @db.Text
  customerSignatureDate DateTime?
  contractorSignature   String?  @db.Text
  contractorSignatureDate DateTime?

  pdfUrl String?

  // HubSpot
  hubspotNoteId String?
  syncedAt      DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
}

model ChangeOrder {
  id              String @id @default(cuid())
  contractId      String
  changeOrderNumber String @unique @default(cuid())

  // Change details
  changesDescription String?
  priceChangeType    String   @default("no_change")  // no_change, increase, decrease
  priceChangeAmount  Float    @default(0)

  // Calculated
  originalPrice   Float @default(0)
  newPrice        Float @default(0)
  newBalanceDue   Float @default(0)

  // Signatures
  customerSignature     String?  @db.Text
  customerSignatureDate DateTime?
  awpSignature          String?  @db.Text
  awpSignatureDate      DateTime?

  pdfUrl String?

  // HubSpot
  hubspotNoteId String?
  syncedAt      DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@index([key])
}

// ─── Commission Models ──────────────────────────────────────

model CommissionConfig {
  id        String              @id @default(cuid())
  modelType CommissionModelType @default(FLAT_PERCENT)
  flatRate  Float?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model CommissionRate {
  id        String   @id @default(cuid())
  userId    String   @unique
  rate      Float
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CommissionTier {
  id        String   @id @default(cuid())
  minAmount Float
  maxAmount Float?
  rate      Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CommissionRecord {
  id            String              @id @default(cuid())
  contractId    String
  userId        String
  contractTotal Float
  modelType     CommissionModelType
  rate          Float
  amount        Float
  notes         String?
  contract      Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([contractId])
  @@index([userId])
  @@index([createdAt])
}
